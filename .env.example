# Le mode simulé reste la valeur sûre pour le développement local et ne contacte jamais OTF.
OTF_DATA_SOURCE=mock

# Le site publié utilise ces valeurs côté serveur en mode live.
# Ne jamais placer de vraie clé dans ce fichier versionné.
# OTF_API_BASE_URL=https://api.ouvretaferme.org/0.1beta
# OTF_API_TOKEN=jeton-conserve-dans-le-gestionnaire-de-secrets

# Fournisseur gratuit de pluie et d'ET0. Conserver la clé uniquement côté serveur.
# Sans cette clé, le module utilise temporairement Open-Meteo.
# VISUAL_CROSSING_API_KEY=cle-conservee-dans-le-gestionnaire-de-secrets
# WEATHER_SYNC_SERVICE_TOKEN=secret-long-partage-uniquement-avec-le-planificateur

# Service Web Push séparé. Les deux secrets ne doivent jamais être exposés au navigateur.
# IRRIGATION_PUSH_SERVICE_URL=https://irrigation-otf-push.example.workers.dev
# IRRIGATION_PUSH_SERVICE_TOKEN=secret-partage-avec-le-worker
# Cette clé VAPID est publique et sert uniquement à abonner le navigateur.
# IRRIGATION_PUSH_VAPID_PUBLIC_KEY=cle-publique-vapid-base64url

# Contournement strictement local si l’en-tête d’authentification Sites manque.
# Ne fonctionne jamais en production.
LOCAL_DEMO_USER=false
