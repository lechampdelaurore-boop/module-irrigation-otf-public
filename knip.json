{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["cloudflare"],
  "workspaces": {
    ".": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/support/register.mjs",
        "tests/support/resolve-hooks.mjs",
        "e2e/**/*.spec.ts",
        "playwright.config.ts",
        "e2e-demo/**/*.spec.ts",
        "tests/support/cloudflare-workers.mjs",
        "scripts/*.ts",
        "vite.config.ts",
        "eslint.config.mjs",
        "demo-worker.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "lib/**/*.ts", "db/**/*.ts", "tests/**/*.{ts,mjs}", "scripts/*.ts", "e2e/**/*.ts", "e2e-demo/**/*.ts"],
      "ignore": ["public/**", "dist/**", ".next/**", ".vinext/**"]
    },
    "cloudflare/irrigation-push": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "cloudflare/irrigation-weather-scheduler": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
