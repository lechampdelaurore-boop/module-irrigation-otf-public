{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Le Worker de la démonstration (docs/demo-guided-contract.md, C1 et
  // section 5, couche 1 ; D4) : le même code que la production, sur son
  // propre point d'entrée (date simulée, remise à zéro de nuit), sa propre
  // base D1 et sa propre adresse. Aucun secret, aucune liaison au Worker de
  // notification, aucune source réelle : le mode démo refuse de démarrer
  // avec l'un ou l'autre (couche 2). Déployé par la CI après la production.
  "name": "module-irrigation-otf-demo",
  "main": "demo-worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Une seule adresse, celle que l'application Access protège.
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "module-irrigation-otf-demo",
      "database_id": "ddbd93f8-c563-416e-b9cb-6961888cc484",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "DEMO_MODE": "true",
    "OTF_DATA_SOURCE": "mock",
    "WEATHER_DATA_SOURCE": "mock",
    "ACCESS_TEAM_DOMAIN": "https://damp-wind-3566.cloudflareaccess.com",
    // L'audience de l'application Access de la démonstration, posée quand
    // elle sera créée ; vide, aucun invité n'est reconnu : rien n'est joignable.
    "ACCESS_AUD": "bc86a6ecb6dc3db1b5823da10d5badb755a3b0ee20536dab14e95c6b249f18cb"
  },
  // La remise à zéro des espaces inactifs depuis plus de 24 heures, chaque
  // nuit à 2 h 17 UTC (section 8).
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
